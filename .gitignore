# ------------------------------------------------------------
# Web project (existing V1 prototype)
# dist/ is intentionally tracked on main; do not ignore it here.
# ------------------------------------------------------------
node_modules/
npm-debug.log*

# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Unity generated files (project lives in unity/)
# Keep: unity/Assets, unity/Packages, unity/ProjectSettings, all .meta files
# ------------------------------------------------------------
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!unity/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# unity/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
unity/[Aa]ssets/Plugins/Editor/JetBrains*

# ------------------------------------------------------------
# IDE / tooling generated files
# ------------------------------------------------------------
unity/.vs/
unity/.vscode/
unity/.idea/
unity/.gradle/
unity/.consulo/
unity/ExportedObj/
unity/*.csproj
unity/*.unityproj
unity/*.sln
unity/*.slnx
unity/*.suo
unity/*.tmp
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db

# Unity3D generated meta files
unity/*.pidb.meta
unity/*.pdb.meta
unity/*.mdb.meta

# Unity3D generated file on crash reports
unity/sysinfo.txt

# Builds
unity/*.apk
unity/*.aab
unity/*.unitypackage
unity/*.app

# Crashlytics generated file
unity/crashlytics-build.properties

# Packed Addressables
unity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
unity/[Aa]ssets/[Ss]treamingAssets/aa.meta
unity/[Aa]ssets/[Ss]treamingAssets/aa/*
